#!/usr/bin/env bash
# A fake `cats` for scripts/cats-harness-selftest.sh: records its argv, checks the
# headers file the harness hands it and writes a canned report. Never prints a
# header value.
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

: "${CATS_FAKE_LOG:?CATS_FAKE_LOG is required}"
printf '%s\n' "$@" >>"$CATS_FAKE_LOG"

# Test hooks (the real cats ignores them):
#   CATS_FAKE_SLEEP=N      hold the run open N seconds (the overlap case).
#   CATS_FAKE_PLANT=MODE   plant a secret of this run where the harness's leak
#                          scan must find it (the fake reads the values the
#                          harness handed it: the headers file, the credential
#                          file and leak.secrets, all next to the headers file):
#                          agent-bearer (stdout, so cats.log), admin-bearer (a
#                          file in the report directory), credential (a key line,
#                          in the report), enrollment (the enrollment token, in the
#                          report), server-log-bearer (the harness's server.log),
#                          smoke-dir (the agent bearer in the smoke output
#                          directory), smoke-line (the agent bearer in the smoke
#                          summary line). spec-examples plants strings shaped like
#                          the spec's example tokens (a JWT and an abe_ token) in
#                          cats.log and the report: the scan must NOT fire on them.
#   CATS_FAKE_KILL_FIXTURE=1|destructive  (destructive: only when --paths names /v1/admin/...) point the first fixture's verify URL at a 404 (a
#                          destructive run that destroyed it).
#   CATS_FAKE_WATCH=FILE   start a detached watcher that writes "present" or
#                          "gone" to FILE when the headers file disappears,
#                          by whether the harness directory still exists then
#                          (so only the harness's own removal reads "present").
sleep "${CATS_FAKE_SLEEP:-0}"
PLANT=${CATS_FAKE_PLANT:-}
JWT_LIKE='eyJfake0000000000.eyJfake1111111111.fakesignature'
ABE_LIKE='abe_FAKEFAKEFAKEFAKEFAKEFAKE'

HDIR=
out=
headers=
prev=
for a in "$@"; do
  case "$a" in --headers=*) headers=${a#--headers=} ;; esac
  [ "$prev" = -o ] && out=$a
  prev=$a
done

[ -z "$headers" ] || HDIR=$(dirname "$headers")

# secret_value KIND: one secret of this run, read from the harness directory.
secret_value() {
  case "$1" in
    agent) sed -n 's/^  Authorization: Bearer //p' "$headers" | head -n 1 ;;
    admin) awk '/^\/v1\/admin\/status:$/ { f = 1; next } f { sub(/^  Authorization: Bearer /, ""); print; exit }' "$headers" ;;
    credential) grep -v -e '^-----' "$HDIR/config/credentials/cats/cats-agent" | head -n 1 ;;
    enrollment) head -n 1 "$HDIR/leak.secrets" ;;
  esac
}

if [ "${1:-}" = smoke ]; then
  case "$PLANT" in
    smoke-dir)
      mkdir -p "$out"
      echo "planted: $(secret_value agent)" >"$out/smoke-report.txt"
      ;;
  esac
  case "$PLANT" in
    smoke-line) echo "Summary: $(secret_value agent)" ;;
    *) echo 'Summary: fake' ;;
  esac
  exit 0
fi

fail() {
  echo "fake-cats: FAIL $*"
  exit 9
}
[ -n "$headers" ] || fail "no --headers argument"
[ -n "$out" ] || fail "no -o argument"
[ -f "$headers" ] || fail "headers file does not exist"
mode=$(stat -c %a "$headers" 2>/dev/null || stat -f %Lp "$headers")
[ "$mode" = 600 ] || fail "headers file mode is $mode, want 600"
grep -q -E '^all:$' "$headers" || fail "headers file has no all: key"
grep -q -E '^/v1/admin/status:$' "$headers" || fail "headers file has no /v1/admin/status: key"

if [ -n "${CATS_FAKE_WATCH:-}" ]; then
  hdir=$(dirname "$headers")
  (
    for ((i = 0; i < 1200; i++)); do
      if [ ! -e "$headers" ]; then
        if [ -f "$hdir/.agentmesh-cats" ]; then echo present; else echo gone; fi >"$CATS_FAKE_WATCH"
        exit 0
      fi
      sleep 0.1
    done
  ) >/dev/null 2>&1 </dev/null &
fi
case "$PLANT" in
  agent-bearer) echo "planted: $(secret_value agent)" ;;
  server-log-bearer) echo "planted: $(secret_value agent)" >>"$HDIR/server.log" ;;
  spec-examples) echo "planted: $JWT_LIKE" ;;
esac

kill_fixture=0
case "${CATS_FAKE_KILL_FIXTURE:-}" in
  1) kill_fixture=1 ;;
  destructive) # only a run over the /v1/admin/ paths
    for a in "$@"; do case "$a" in --paths=/v1/admin/*) kill_fixture=1 ;; esac; done
    ;;
esac
if [ "$kill_fixture" = 1 ]; then
  # Simulates a destructive run: the first fixture's verify URL now answers 404.
  fx=$(dirname "$headers")/fixtures.json
  jq '.fixtures |= (map(if .key == "channel" then .verify_url |= (sub("/v1/.*$"; "") + "/v1/channels/cats-killed-fixture/acl") else . end))' "$fx" >"$fx.new"
  mv "$fx.new" "$fx"
fi

mkdir -p "$out"
case "$PLANT" in
  admin-bearer) echo "planted: $(secret_value admin)" >"$out/leak.txt" ;;
  credential) echo "planted: $(secret_value credential)" >"$out/leak.txt" ;;
  enrollment) echo "planted: $(secret_value enrollment)" >"$out/leak.txt" ;;
  spec-examples) echo "planted: $ABE_LIKE" >"$out/leak.txt" ;;
esac
echo '{"totalTests":"3","success":"1","warnings":"1","errors":"1","runStatus":"COMPLETED","qualityGatePassed":false}' \
  >"$out/cats-summary-report.json"
for n in 1 2 3; do cp "$HERE/report/Test$n.json" "$out/Test$n.json"; done
echo "fake-cats: wrote 3 tests"
exit 1
