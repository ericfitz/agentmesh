# Copy to deploy/.env and set a real password. deploy/.env is never committed.
POSTGRES_PASSWORD=change-me
AGENTMESH_ISSUER=http://localhost:8420
# The installation's name: the common name of its intermediate certificate (ADR 0019). Use the same value
# when you run `ca csr` and `ca install` (see the comment at the top of docker-compose.yml). Each installation
# under one root needs a name of its own.
AGENTMESH_INSTALLATION_NAME=agentmesh-compose
# The user the containers run as. The default is the image's nonroot user (65532); on a host where you made
# deploy/ca/intermediate.key yourself, set your own ids (`id -u`, `id -g`) so the container can read it.
AGENTMESH_UID=65532
AGENTMESH_GID=65532
